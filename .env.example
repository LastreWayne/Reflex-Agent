# ─── Decisor (Claude) ────────────────────────────────────────────────────────
# Sólo se lee en el servidor, dentro de app/api/decide/route.ts. Nunca entra
# al bundle del navegador.
ANTHROPIC_API_KEY=

# El modelo se elige por superficie, no por código:
#   · playground público  → claude-sonnet-5 (barato, muchas visitas)
#   · video grabado       → claude-opus-5 con DECIDER_FAST=1
# Si no se define nada, el default del código es claude-sonnet-5.
DECIDER_MODEL=claude-sonnet-5

# DECIDER_FAST=1 activa fast mode. Sólo existe en claude-opus-5 y
# claude-opus-4-8: combinarlo con cualquier otro modelo hace que el decisor
# falle al construirse (error 500 explícito, no un fallo silencioso).
DECIDER_FAST=0

# ─── Destinos de las acciones ────────────────────────────────────────────────
# Todos opcionales. Si falta uno, la acción no rompe: reporta
# "Falta la variable X" en el carril de Acción.
#
# ⚠️ LAS CUATRO VAN VACÍAS EN EL DEPLOY PÚBLICO, y esa ausencia ES la
# mitigación: /api/decide y /api/execute son rutas públicas y sin
# autenticación, así que sin la variable el executor corta ANTES de cualquier
# llamada de red. Dejar una con valor abre un relay anónimo hacia ese destino.
# Sólo el deploy de grabación las lleva cargadas.

# volt / alert-ops (discord)
DISCORD_OPS_WEBHOOK=

# restaurant / avisar-dueno (ntfy)
# Iba con `centinela-demo` de default y no debía: un topic de ntfy es público y
# escribible por cualquiera, así que quien provisionara desde este archivo
# dejaba /api/execute posteando texto arbitrario a ntfy.sh sin saberlo.
NTFY_TOPIC=

# volt / create-ticket (github_issue)
GITHUB_REPO=
GITHUB_TOKEN=
